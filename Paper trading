function updateOrderTotal(){
  if(!pendingOrder) return;
  const stock = STOCKS.find(s=>s.sym===pendingOrder.sym);
  const qty = Math.max(0, parseInt(document.getElementById('qtyInput').value)||0);
  document.getElementById('orderTotal').textContent = inr(stock.ltp*qty);
}
function closeModal(){ document.getElementById('modalOverlay').classList.remove('show'); pendingOrder=null; }
async function submitOrder(){
  if(!pendingOrder) return;
  const {sym, side} = pendingOrder;
  const stock = STOCKS.find(s=>s.sym===sym);
  const qty = parseInt(document.getElementById('qtyInput').value)||0;
  const errBox = document.getElementById('formErr');
  if(qty<=0){ errBox.textContent='Enter a quantity greater than zero.'; errBox.style.display='block'; return; }
  const cost = stock.ltp*qty;
  if(side==='buy'){
    if(cost > portfolio.cash){ errBox.textContent='Insufficient cash balance for this order.'; errBox.style.display='block'; return; }
    const existing = portfolio.holdings[sym] || {qty:0, avgCost:0};
    const newQty = existing.qty+qty;
    const newAvg = ((existing.avgCost*existing.qty)+cost)/newQty;
    portfolio.holdings[sym] = {qty:newQty, avgCost:Number(newAvg.toFixed(2))};
    portfolio.cash = Number((portfolio.cash-cost).toFixed(2));
  } else {
    const existing = portfolio.holdings[sym] || {qty:0, avgCost:0};
    if(qty > existing.qty){ errBox.textContent='You only hold '+existing.qty+' shares of '+sym+'.'; errBox.style.display='block'; return; }
    existing.qty -= qty; portfolio.holdings[sym]=existing;
    portfolio.cash = Number((portfolio.cash+cost).toFixed(2));
  }
  portfolio.transactions.push({time:Date.now(), sym, side, qty, price:stock.ltp});
  await savePortfolio(currentRoll, portfolio);
  closeModal(); refreshTabs();
}
