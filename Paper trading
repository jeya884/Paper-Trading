function renderChartTab(){
  const allSyms = [...INDICES.map(i=>i.sym), ...STOCKS.map(s=>s.sym)];
  document.getElementById('tabContent').innerHTML = `
    <div class="section-title">Price Chart &amp; Trade Entries</div>
    <div class="field" style="max-width:240px;">
      <label>Instrument</label>
      <select id="chartSelect">${allSyms.map(s=>`<option value="${s}" ${s===chartSelectedSym?'selected':''}>${s}</option>`).join('')}</select>
    </div>
    <div class="table-wrap" style="padding:14px; margin-bottom:20px;"><canvas id="priceCanvas" style="width:100%; height:300px; display:block;"></canvas></div>
    <div class="section-title" style="font-size:16px;">All Entries — <span id="chartEntrySym">${chartSelectedSym}</span></div>
    <div class="table-wrap" id="entriesWrap"></div>`;
  document.getElementById('chartSelect').addEventListener('change', e=>{ chartSelectedSym=e.target.value; refreshChart(); });
  refreshChart();
}
function getEntriesForSymbol(sym){
  const out = [];
  portfolio.transactions.filter(t=>t.sym===sym).forEach(t=> out.push({t:t.time, price:t.price, buy:t.side==='buy', qty:t.qty, label:sym+' Equity'}));
  portfolio.fno.transactions.filter(t=>t.underlying===sym).forEach(t=>{
    const label = t.kind==='FUT' ? sym+' FUT' : sym+' '+t.strike+' '+t.optType;
    out.push({t:t.time, price:t.spotAtEntry, buy:t.side==='buy', qty:t.lots, label});
  });
  out.sort((a,b)=>a.t-b.t);
  return out;
}
function drawChart(sym){
  const canvas = document.getElementById('priceCanvas'); if(!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.width = canvas.clientWidth || 600;
  const H = canvas.height = 300;
  ctx.clearRect(0,0,W,H);
  const hist = priceHistory[sym] || [];
  if(hist.length < 2){ ctx.fillStyle='#6B7680'; ctx.font='13px IBM Plex Mono, monospace'; ctx.fillText('Gathering price data…', 16, H/2); return; }
  const entries = getEntriesForSymbol(sym);
  const times = hist.map(h=>h.t); const prices = hist.map(h=>h.p);
  const tMin = Math.min(...times), tMax = Math.max(...times);
  let pMin = Math.min(...prices), pMax = Math.max(...prices);
  entries.forEach(e=>{ pMin = Math.min(pMin,e.price); pMax = Math.max(pMax,e.price); });
  const pad = (pMax-pMin)*0.12 || pMax*0.02; pMin -= pad; pMax += pad;
  const marginL=58, marginR=14, marginT=14, marginB=14;
  const plotW = W-marginL-marginR, plotH = H-marginT-marginB;
  const xOf = t => marginL + ((t-tMin)/((tMax-tMin)||1))*plotW;
  const yOf = p => marginT + plotH - ((p-pMin)/((pMax-pMin)||1))*plotH;

  ctx.strokeStyle = '#1F2A33'; ctx.fillStyle = '#6B7680'; ctx.font = '10px IBM Plex Mono, monospace'; ctx.lineWidth = 1;
  for(let i=0;i<=4;i++){
    const p = pMin + (pMax-pMin)*i/4; const y = yOf(p);
    ctx.beginPath(); ctx.moveTo(marginL,y); ctx.lineTo(W-marginR,y); ctx.stroke();
    ctx.fillText(p.toFixed(0), 4, y+3);
  }

  ctx.beginPath();
  hist.forEach((h,i)=>{ const x=xOf(h.t), y=yOf(h.p); if(i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y); });
  ctx.strokeStyle = '#D4A93F'; ctx.lineWidth = 1.8; ctx.stroke();

  entries.forEach(e=>{
    const x = xOf(Math.max(tMin, Math.min(tMax, e.t))), y = yOf(e.price);
    ctx.beginPath(); ctx.fillStyle = e.buy ? '#2FBF71' : '#E2564F';
    if(e.buy){ ctx.moveTo(x-5,y+6); ctx.lineTo(x+5,y+6); ctx.lineTo(x,y-4); }
    else { ctx.moveTo(x-5,y-6); ctx.lineTo(x+5,y-6); ctx.lineTo(x,y+4); }
    ctx.closePath(); ctx.fill();
  });
}
function refreshChart(){
  drawChart(chartSelectedSym);
  const entries = getEntriesForSymbol(chartSelectedSym);
  const symLabel = document.getElementById('chartEntrySym'); if(symLabel) symLabel.textContent = chartSelectedSym;
  const wrap = document.getElementById('entriesWrap'); if(!wrap) return;
  if(entries.length===0){ wrap.innerHTML = `<div class="empty-state">No trade entries yet for ${chartSelectedSym}.</div>`; return; }
  wrap.innerHTML = `<table><thead><tr><th>Time</th><th>Instrument</th><th>Side</th><th>Qty/Lots</th><th>Price</th></tr></thead>
    <tbody>${[...entries].reverse().map(e=>`<tr><td>${new Date(e.t).toLocaleString('en-IN')}</td><td>${e.label}</td>
      <td class="chg ${e.buy?'up':'dn'}">${e.buy?'BUY':'SELL'}</td><td>${e.qty}</td><td>${inr(e.price)}</td></tr>`).join('')}</tbody></table>`;
}

