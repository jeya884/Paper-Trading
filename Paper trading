<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>PaperFloor — F&amp;O Trading Floor</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0A0E14; --panel:#10161D; --panel-alt:#141B23; --border:#1F2A33;
    --text:#C9D3D9; --text-dim:#6B7680; --text-bright:#F1F4F6;
    --gold:#D4A93F; --gold-dim:#8A7233;
    --bull:#2FBF71; --bull-bg:rgba(47,191,113,0.12);
    --bear:#E2564F; --bear-bg:rgba(226,86,79,0.12);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html,body{height:100%;}
  body{ background:var(--bg); color:var(--text); font-family:'IBM Plex Sans', sans-serif; min-height:100vh; display:flex; flex-direction:column; overflow-x:hidden; }
  .mono{font-family:'IBM Plex Mono', monospace;}

  #ticker-wrap{ background:#05070A; border-bottom:1px solid var(--border); overflow:hidden; white-space:nowrap; padding:9px 0; position:relative; flex-shrink:0; }
  #ticker-wrap::before, #ticker-wrap::after{ content:""; position:absolute; top:0; bottom:0; width:60px; z-index:2; }
  #ticker-wrap::before{ left:0; background:linear-gradient(90deg, #05070A, transparent);}
  #ticker-wrap::after{ right:0; background:linear-gradient(-90deg, #05070A, transparent);}
  #ticker-track{ display:inline-flex; animation: scroll-ticker 60s linear infinite; will-change: transform; }
  @keyframes scroll-ticker{ from{ transform: translateX(0);} to{ transform: translateX(-50%);} }
  .tick-item{ font-family:'IBM Plex Mono', monospace; font-size:12.5px; letter-spacing:0.04em; padding:0 22px; display:inline-flex; align-items:center; gap:7px; color:var(--text-dim); }
  .tick-item .sym{ color:var(--gold); font-weight:600; }
  .tick-item .up{ color:var(--bull); } .tick-item .dn{ color:var(--bear); }
  @media (prefers-reduced-motion: reduce){ #ticker-track{ animation: none; } }

  #app{ flex:1; display:flex; flex-direction:column; }

  .gate{ flex:1; display:flex; align-items:center; justify-content:center; padding:32px 16px;
    background: radial-gradient(ellipse 900px 500px at 50% -10%, rgba(212,169,63,0.08), transparent); }
  .gate-card{ width:100%; max-width:400px; background:var(--panel); border:1px solid var(--border); position:relative; }
  .gate-card::before{ content:""; position:absolute; top:0; left:0; right:0; height:3px; background:linear-gradient(90deg, var(--gold), var(--gold-dim), var(--gold)); }
  .gate-head{ padding:32px 32px 20px; border-bottom:1px dashed var(--border); text-align:center; }
  .gate-brand{ font-family:'Big Shoulders Display', sans-serif; font-weight:800; font-size:34px; letter-spacing:0.03em; color:var(--text-bright); text-transform:uppercase; }
  .gate-brand span{ color:var(--gold); }
  .gate-sub{ font-size:11px; letter-spacing:0.18em; text-transform:uppercase; color:var(--text-dim); margin-top:6px; }
  .gate-body{ padding:28px 32px 32px; }
  .field{ margin-bottom:18px; }
  .field label{ display:block; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:var(--text-dim); margin-bottom:7px; }
  .field input, .field select{ width:100%; background:var(--panel-alt); border:1px solid var(--border); color:var(--text-bright); padding:11px 13px; font-family:'IBM Plex Mono', monospace; font-size:14.5px; letter-spacing:0.04em; outline:none; transition:border-color .15s; }
  .field input:focus, .field select:focus{ border-color:var(--gold); }
  .field-hint{ font-size:11px; color:var(--text-dim); margin-top:6px; line-height:1.5;}
  .btn{ width:100%; padding:12px; background:var(--gold); color:#0A0E14; border:none; font-family:'IBM Plex Sans', sans-serif; font-weight:700; font-size:13px; letter-spacing:0.08em; text-transform:uppercase; cursor:pointer; transition:filter .15s, transform .05s; }
  .btn:hover{ filter:brightness(1.08); } .btn:active{ transform:translateY(1px); }
  .btn-outline{ background:transparent; border:1px solid var(--border); color:var(--text); }
  .btn-outline:hover{ border-color:var(--gold); color:var(--gold); filter:none; }
  .btn-sell{ background:var(--bear); color:#fff; } .btn-buy{ background:var(--bull); color:#06170F; }
  .gate-error{ background:var(--bear-bg); border:1px solid var(--bear); color:var(--bear); font-size:12.5px; padding:9px 12px; margin-bottom:16px; display:none; }
  .gate-note{ text-align:center; font-size:11px; color:var(--text-dim); padding:16px 32px 26px; border-top:1px dashed var(--border); }

  .topbar{ display:flex; align-items:center; justify-content:space-between; padding:14px 26px; border-bottom:1px solid var(--border); background:var(--panel); flex-wrap:wrap; gap:12px; }
  .topbar-left{ display:flex; align-items:center; gap:14px; }
  .topbar-brand{ font-family:'Big Shoulders Display', sans-serif; font-weight:800; font-size:22px; letter-spacing:0.03em; color:var(--text-bright); text-transform:uppercase; }
  .topbar-brand span{ color:var(--gold); }
  .badge-roll{ font-family:'IBM Plex Mono', monospace; font-size:11.5px; color:var(--text-dim); border:1px solid var(--border); padding:3px 9px; }
  .topbar-right{ display:flex; align-items:center; gap:18px; }
  .cash-pill{ font-family:'IBM Plex Mono', monospace; font-size:13px; color:var(--text-bright); border-left:2px solid var(--gold); padding-left:10px; }
  .cash-pill .lbl{ color:var(--text-dim); font-size:10.5px; text-transform:uppercase; letter-spacing:0.08em; display:block; margin-bottom:2px;}
  .logout-btn{ background:none; border:1px solid var(--border); color:var(--text-dim); padding:7px 14px; font-size:11px; letter-spacing:0.08em; text-transform:uppercase; cursor:pointer; }
  .logout-btn:hover{ border-color:var(--bear); color:var(--bear); }

  .tabs{ display:flex; gap:2px; padding:0 26px; background:var(--panel); border-bottom:1px solid var(--border); overflow-x:auto; }
  .tab-btn{ background:none; border:none; color:var(--text-dim); padding:13px 18px; font-size:12.5px; letter-spacing:0.06em; text-transform:uppercase; cursor:pointer; border-bottom:2px solid transparent; white-space:nowrap; font-family:'IBM Plex Sans', sans-serif; font-weight:600; }
  .tab-btn.active{ color:var(--gold); border-bottom-color:var(--gold); }
  .tab-btn:hover:not(.active){ color:var(--text-bright); }
  .subtabs{ padding:0; margin-bottom:16px; background:transparent; border-bottom:1px solid var(--border); }

  .content{ flex:1; padding:22px 26px 40px; max-width:1200px; width:100%; margin:0 auto; }
  .section-title{ font-family:'Big Shoulders Display', sans-serif; font-weight:700; font-size:20px; letter-spacing:0.03em; text-transform:uppercase; color:var(--text-bright); margin-bottom:14px; }
  .grid-summary{ display:grid; grid-template-columns:repeat(auto-fit, minmax(160px,1fr)); gap:12px; margin-bottom:26px; }
  .stat-card{ background:var(--panel); border:1px solid var(--border); padding:14px 16px; }
  .stat-card .lbl{ font-size:10.5px; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-dim); margin-bottom:6px;}
  .stat-card .val{ font-family:'IBM Plex Mono', monospace; font-size:19px; color:var(--text-bright); }
  .stat-card .val.up{ color:var(--bull); } .stat-card .val.dn{ color:var(--bear); }

  table{ width:100%; border-collapse:collapse; }
  thead th{ text-align:left; font-size:10.5px; text-transform:uppercase; letter-spacing:0.07em; color:var(--text-dim); padding:10px 12px; border-bottom:1px solid var(--border); font-weight:600; }
  tbody td{ padding:11px 12px; border-bottom:1px solid var(--border); font-family:'IBM Plex Mono', monospace; font-size:13px; color:var(--text); vertical-align:middle; }
  tbody tr:hover{ background:var(--panel-alt); }
  .name-sub{ font-family:'IBM Plex Sans',sans-serif; font-size:11px; color:var(--text-dim); }
  .chg.up{ color:var(--bull); } .chg.dn{ color:var(--bear); }
  .row-actions{ display:flex; gap:6px; flex-wrap:wrap; }
  .mini-btn{ padding:6px 12px; font-size:11px; text-transform:uppercase; letter-spacing:0.05em; border:none; cursor:pointer; font-family:'IBM Plex Sans',sans-serif; font-weight:700; }
  .empty-state{ text-align:center; padding:50px 20px; color:var(--text-dim); border:1px dashed var(--border); font-size:13px; }
  .table-wrap{ background:var(--panel); border:1px solid var(--border); overflow-x:auto; }

  .modal-overlay{ position:fixed; inset:0; background:rgba(5,7,10,0.75); display:none; align-items:center; justify-content:center; z-index:50; padding:16px; }
  .modal-overlay.show{ display:flex; }
  .modal{ width:100%; max-width:380px; background:var(--panel); border:1px solid var(--border); position:relative; }
  .modal::before{ content:""; position:absolute; top:0; left:0; right:0; height:3px; }
  .modal.buy-mode::before{ background:var(--bull); } .modal.sell-mode::before{ background:var(--bear); }
  .modal-head{ padding:20px 22px 14px; border-bottom:1px dashed var(--border); }
  .modal-head .m-sym{ font-family:'Big Shoulders Display',sans-serif; font-size:22px; color:var(--text-bright); font-weight:700;}
  .modal-head .m-price{ font-family:'IBM Plex Mono',monospace; font-size:13px; color:var(--text-dim); margin-top:4px;}
  .modal-body{ padding:20px 22px; }
  .modal-foot{ padding:0 22px 22px; display:flex; gap:10px; }
  .modal-foot .btn{ flex:1; }
  .order-total{ font-family:'IBM Plex Mono',monospace; font-size:13px; color:var(--text-bright); background:var(--panel-alt); border:1px solid var(--border); padding:10px 12px; margin-bottom:16px; display:flex; justify-content:space-between; }
  .close-x{ position:absolute; top:14px; right:16px; background:none; border:none; color:var(--text-dim); font-size:18px; cursor:pointer; line-height:1; }
  .close-x:hover{ color:var(--text-bright); }
  .form-err{ color:var(--bear); font-size:11.5px; margin-top:8px; display:none; }

  ::-webkit-scrollbar{ height:8px; width:8px; }
  ::-webkit-scrollbar-thumb{ background:var(--border); }
</style>
</head>
<body>

  <div id="ticker-wrap"><div id="ticker-track"></div></div>
  <div id="app"></div>

  <!-- Equity order modal -->
  <div class="modal-overlay" id="modalOverlay">
    <div class="modal" id="orderModal">
      <button class="close-x" id="modalClose">&times;</button>
      <div class="modal-head">
        <div class="m-sym" id="mSym">—</div>
        <div class="m-price mono" id="mPrice">LTP ₹0.00</div>
      </div>
      <div class="modal-body">
        <div class="field"><label id="qtyLabel">Quantity</label><input type="number" id="qtyInput" min="1" value="1" /></div>
        <div class="order-total"><span>Order Value</span><span id="orderTotal">₹0.00</span></div>
        <div class="form-err" id="formErr"></div>
      </div>
      <div class="modal-foot">
        <button class="btn btn-outline" id="modalCancel">Cancel</button>
        <button class="btn" id="modalSubmit">Confirm</button>
      </div>
    </div>
  </div>

  <!-- F&O order modal -->
  <div class="modal-overlay" id="fnoModalOverlay">
    <div class="modal" id="fnoOrderModal">
      <button class="close-x" id="fnoModalClose">&times;</button>
      <div class="modal-head">
        <div class="m-sym" id="fnoMSym">—</div>
        <div class="m-price mono" id="fnoMPrice">—</div>
      </div>
      <div class="modal-body">
        <div class="field"><label id="fnoLotsLabel">Lots</label><input type="number" id="fnoLotsInput" min="1" value="1" /></div>
        <div class="order-total"><span>Est. Notional</span><span id="fnoOrderTotal">₹0.00</span></div>
        <div class="form-err" id="fnoFormErr"></div>
      </div>
      <div class="modal-foot">
        <button class="btn btn-outline" id="fnoModalCancel">Cancel</button>
        <button class="btn" id="fnoModalSubmit">Confirm</button>
      </div>
    </div>
  </div>

<script>
/* ===================== DATA ===================== */
function genRollNumbers(){ const l=[]; for(let i=1;i<=175;i++) l.push('25MBA'+String(i).padStart(2,'0')); return l; }
const VALID_ROLLS = genRollNumbers();
const STARTING_CASH = 1000000;

const STOCK_SEED = [
  {sym:'TCS', name:'Tata Consultancy Services', sector:'IT', price:3850},
  {sym:'INFY', name:'Infosys Ltd', sector:'IT', price:1620},
  {sym:'WIPRO', name:'Wipro Ltd', sector:'IT', price:480},
  {sym:'HCLTECH', name:'HCL Technologies', sector:'IT', price:1750},
  {sym:'HDFCBANK', name:'HDFC Bank', sector:'Banking', price:1680},
  {sym:'ICICIBANK', name:'ICICI Bank', sector:'Banking', price:1150},
  {sym:'SBIN', name:'State Bank of India', sector:'Banking', price:810},
  {sym:'KOTAKBANK', name:'Kotak Mahindra Bank', sector:'Banking', price:1780},
  {sym:'HUL', name:'Hindustan Unilever', sector:'FMCG', price:2450},
  {sym:'ITC', name:'ITC Ltd', sector:'FMCG', price:460},
  {sym:'NESTLEIND', name:'Nestle India', sector:'FMCG', price:2380},
  {sym:'MARUTI', name:'Maruti Suzuki', sector:'Auto', price:11200},
  {sym:'TATAMOTORS', name:'Tata Motors', sector:'Auto', price:920},
  {sym:'M&M', name:'Mahindra & Mahindra', sector:'Auto', price:2650},
  {sym:'SUNPHARMA', name:'Sun Pharma', sector:'Pharma', price:1780},
  {sym:'DRREDDY', name:"Dr. Reddy's Labs", sector:'Pharma', price:6200},
  {sym:'CIPLA', name:'Cipla Ltd', sector:'Pharma', price:1490},
  {sym:'RELIANCE', name:'Reliance Industries', sector:'Energy', price:2890},
  {sym:'ONGC', name:'Oil & Natural Gas Corp', sector:'Energy', price:260},
  {sym:'NTPC', name:'NTPC Ltd', sector:'Energy', price:380},
  {sym:'ADANIENT', name:'Adani Enterprises', sector:'Diversified', price:2950},
  {sym:'BHARTIARTL', name:'Bharti Airtel', sector:'Telecom', price:1590},
];
let STOCKS = STOCK_SEED.map(s => ({...s, prevClose:s.price, ltp:s.price}));

const FNO_UNDERLYINGS = [
  {sym:'NIFTY', name:'Nifty 50 Index', kind:'INDEX', spot:24500, sigma:0.13, lotSize:75, strikeStep:100},
  {sym:'BANKNIFTY', name:'Bank Nifty Index', kind:'INDEX', spot:51500, sigma:0.15, lotSize:30, strikeStep:100},
  {sym:'RELIANCE', name:'Reliance Industries', kind:'STOCK', sigma:0.24, lotSize:250, strikeStep:20},
  {sym:'TCS', name:'Tata Consultancy Services', kind:'STOCK', sigma:0.20, lotSize:150, strikeStep:50},
  {sym:'HDFCBANK', name:'HDFC Bank', kind:'STOCK', sigma:0.19, lotSize:550, strikeStep:20},
  {sym:'INFY', name:'Infosys Ltd', kind:'STOCK', sigma:0.22, lotSize:400, strikeStep:20},
  {sym:'SBIN', name:'State Bank of India', kind:'STOCK', sigma:0.25, lotSize:1500, strikeStep:10},
];
let INDICES = FNO_UNDERLYINGS.filter(u=>u.kind==='INDEX').map(u=>({sym:u.sym, name:u.name, price:u.spot, prevClose:u.spot, ltp:u.spot}));

const EXPIRY_DATE = new Date('2026-09-25T15:30:00');
const RISK_FREE = 0.065;
let priceHistory = {};

/* ===================== STATE ===================== */
let currentRoll = null;
let portfolio = defaultPortfolio();
let activeTab = 'market';
let pendingOrder = null;
let pendingFno = null;
let fnoSubTab = 'futures';
let fnoSelectedUnderlying = 'NIFTY';
let chartSelectedSym = 'NIFTY';

function defaultPortfolio(){ return { cash: STARTING_CASH, holdings:{}, transactions:[], fno:{ positions:{}, transactions:[] } }; }

/* ===================== STORAGE ===================== */
async function loadPortfolio(roll){
  try{
    const res = await window.storage.get('pf_user_' + roll, false);
    if(res && res.value){
      const parsed = JSON.parse(res.value);
      if(!parsed.fno) parsed.fno = { positions:{}, transactions:[] };
      return parsed;
    }
  }catch(e){ /* no existing record */ }
  return defaultPortfolio();
}
async function savePortfolio(roll, data){
  try{ await window.storage.set('pf_user_' + roll, JSON.stringify(data), false); }
  catch(e){ console.error('storage save failed', e); }
}

/* ===================== HELPERS ===================== */
function inr(n){ return '₹' + Number(n||0).toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2}); }
function pct(n){ return (n>=0?'+':'') + n.toFixed(2) + '%'; }
function getSpot(sym){
  const idx = INDICES.find(i=>i.sym===sym); if(idx) return idx.ltp;
  const st = STOCKS.find(s=>s.sym===sym); return st ? st.ltp : 0;
}
function daysToExpiry(){ return Math.max(1, Math.ceil((EXPIRY_DATE - Date.now())/86400000)); }
function futPrice(spot){ return Number((spot*(1 + RISK_FREE*daysToExpiry()/365)).toFixed(2)); }
function erf(x){
  const sign = x<0?-1:1; x=Math.abs(x);
  const a1=0.254829592,a2=-0.284496736,a3=1.421413741,a4=-1.453152027,a5=1.061405429,p=0.3275911;
  const t=1/(1+p*x);
  const y=1-(((((a5*t+a4)*t)+a3)*t+a2)*t+a1)*t*Math.exp(-x*x);
  return sign*y;
}
function normCDF(x){ return 0.5*(1+erf(x/Math.sqrt(2))); }
function bsPrice(spot,strike,tYears,r,sigma,type){
  if(tYears<=0) tYears=0.0007;
  const d1=(Math.log(spot/strike)+(r+0.5*sigma*sigma)*tYears)/(sigma*Math.sqrt(tYears));
  const d2=d1-sigma*Math.sqrt(tYears);
  const val = type==='CE'
    ? spot*normCDF(d1) - strike*Math.exp(-r*tYears)*normCDF(d2)
    : strike*Math.exp(-r*tYears)*normCDF(-d2) - spot*normCDF(-d1);
  return Math.max(0.05, val);
}
function getOptionChain(underlyingSym){
  const cfg = FNO_UNDERLYINGS.find(u=>u.sym===underlyingSym);
  const spot = getSpot(underlyingSym);
  const step = cfg.strikeStep;
  const atm = Math.round(spot/step)*step;
  const strikes = [];
  for(let i=-5;i<=5;i++) strikes.push(atm+i*step);
  const t = daysToExpiry()/365;
  return strikes.map(k=>({ strike:k, ce:Number(bsPrice(spot,k,t,RISK_FREE,cfg.sigma,'CE').toFixed(2)), pe:Number(bsPrice(spot,k,t,RISK_FREE,cfg.sigma,'PE').toFixed(2)) }));
}

/* ===================== PRICE HISTORY SEED ===================== */
function seedPriceHistory(){
  const now = Date.now();
  [...STOCKS, ...INDICES].forEach(inst=>{
    const temp=[inst.ltp]; let p=inst.ltp;
    for(let i=0;i<59;i++){ p = p/(1+(Math.random()-0.5)*0.006); temp.push(p); }
    temp.reverse();
    priceHistory[inst.sym] = temp.map((val,idx)=>({ t: now-(temp.length-1-idx)*60000, p:Number(val.toFixed(2)) }));
  });
}

/* ===================== TICKER ===================== */
function renderTicker(){
  const track = document.getElementById('ticker-track');
  const buildSet = () => [...INDICES, ...STOCKS].map(s=>{
    const chg = s.ltp - s.prevClose; const chgPct=(chg/s.prevClose)*100;
    const cls = chg>=0?'up':'dn'; const arrow = chg>=0?'▲':'▼';
    return `<span class="tick-item"><span class="sym">${s.sym}</span><span>${inr(s.ltp)}</span><span class="${cls}">${arrow} ${pct(chgPct)}</span></span>`;
  }).join('');
  track.innerHTML = buildSet() + buildSet();
}

/* ===================== PRICE SIMULATION ===================== */
function tickPrices(){
  STOCKS = STOCKS.map(s=>{ const drift=(Math.random()-0.5)*0.006; return {...s, ltp:Number(Math.max(1,s.ltp*(1+drift)).toFixed(2))}; });
  INDICES = INDICES.map(s=>{ const drift=(Math.random()-0.5)*0.003; return {...s, ltp:Number(Math.max(1,s.ltp*(1+drift)).toFixed(2))}; });
  [...STOCKS, ...INDICES].forEach(inst=>{
    if(!priceHistory[inst.sym]) priceHistory[inst.sym]=[];
    priceHistory[inst.sym].push({t:Date.now(), p:inst.ltp});
    if(priceHistory[inst.sym].length>150) priceHistory[inst.sym].shift();
  });
  renderTicker();
  if(currentRoll){
    if(activeTab==='market') renderMarketTable();
    if(activeTab==='portfolio') renderPortfolioTable();
    if(activeTab==='fno') refreshFnoSub();
    if(activeTab==='chart') refreshChart();
    renderSummaryStats();
  }
}
setInterval(tickPrices, 2500);

/* ===================== LOGIN ===================== */
function renderLogin(){
  currentRoll = null;
  document.getElementById('app').innerHTML = `
    <div class="gate">
      <div class="gate-card">
        <div class="gate-head">
          <div class="gate-brand">PAPER<span>FLOOR</span></div>
          <div class="gate-sub">Trading Floor Access</div>
        </div>
        <div class="gate-body">
          <div class="gate-error" id="loginErr"></div>
          <div class="field"><label>Roll Number</label><input type="text" id="rollInput" placeholder="25MBA01" autocomplete="off" /></div>
          <div class="field">
            <label>Password</label>
            <input type="password" id="passInput" placeholder="Same as roll number" autocomplete="off" />
            <div class="field-hint">Your password is your roll number, entered exactly as issued (e.g. 25MBA01).</div>
          </div>
          <button class="btn" id="loginBtn">Enter Floor</button>
        </div>
        <div class="gate-note">Access is restricted to registered roll numbers 25MBA01 – 25MBA175.</div>
      </div>
    </div>`;
  document.getElementById('loginBtn').addEventListener('click', doLogin);
  document.getElementById('passInput').addEventListener('keydown', e=>{ if(e.key==='Enter') doLogin(); });
  document.getElementById('rollInput').addEventListener('keydown', e=>{ if(e.key==='Enter') document.getElementById('passInput').focus(); });
}
async function doLogin(){
  const roll = document.getElementById('rollInput').value.trim().toUpperCase();
  const pass = document.getElementById('passInput').value.trim().toUpperCase();
  const errBox = document.getElementById('loginErr');
  if(!VALID_ROLLS.includes(roll)){ errBox.textContent='Roll number not recognised. Valid range: 25MBA01 – 25MBA175.'; errBox.style.display='block'; return; }
  if(roll !== pass){ errBox.textContent='Password must match your roll number exactly.'; errBox.style.display='block'; return; }
  errBox.style.display='none';
  currentRoll = roll;
  portfolio = await loadPortfolio(roll);
  activeTab = 'market';
  renderDashboard();
}

/* ===================== DASHBOARD SHELL ===================== */
function renderDashboard(){
  document.getElementById('app').innerHTML = `
    <div class="topbar">
