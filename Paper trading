function closeFnoModal(){ document.getElementById('fnoModalOverlay').classList.remove('show'); pendingFno=null; }
async function submitFnoOrder(){
  if(!pendingFno) return;
  const {kind, underlying, strike, optType, lotSize, side} = pendingFno;
  const lots = parseInt(document.getElementById('fnoLotsInput').value)||0;
  const errBox = document.getElementById('fnoFormErr');
  if(lots<=0){ errBox.textContent='Enter lots greater than zero.'; errBox.style.display='block'; return; }
  const spot = getSpot(underlying);
  const cfgSigma = kind==='OPT' ? FNO_UNDERLYINGS.find(u=>u.sym===underlying).sigma : null;
  const price = kind==='FUT' ? futPrice(spot) : bsPrice(spot, strike, daysToExpiry()/365, RISK_FREE, cfgSigma, optType);
  const key = kind==='FUT' ? underlying+'_FUT' : underlying+'_'+strike+'_'+optType;
  let pos = portfolio.fno.positions[key];
  const actionSide = side==='buy' ? 'long' : 'short';

  if(!pos || pos.lots===0){
    const notional = lots*lotSize*price;
    let marginDelta=0, cashDelta=0;
    if(kind==='FUT'){ marginDelta=notional*0.12; cashDelta=-marginDelta; }
    else if(actionSide==='long'){ cashDelta=-notional; }
    else { marginDelta=notional*0.15; cashDelta=notional-marginDelta; }
    const required = Math.max(0,-cashDelta);
    if(required > portfolio.cash){ errBox.textContent='Insufficient cash. Required: '+inr(required); errBox.style.display='block'; return; }
    portfolio.cash = Number((portfolio.cash+cashDelta).toFixed(2));
    portfolio.fno.positions[key] = {kind, underlying, strike:strike||null, optType:optType||null, lotSize, side:actionSide, lots, avgPrice:price, margin:marginDelta};
  } else if(pos.side===actionSide){
    const notional = lots*lotSize*price;
    let marginDelta=0, cashDelta=0;
    if(kind==='FUT'){ marginDelta=notional*0.12; cashDelta=-marginDelta; }
    else if(actionSide==='long'){ cashDelta=-notional; }
    else { marginDelta=notional*0.15; cashDelta=notional-marginDelta; }
    const required = Math.max(0,-cashDelta);
    if(required > portfolio.cash){ errBox.textContent='Insufficient cash for this addition.'; errBox.style.display='block'; return; }
    portfolio.cash = Number((portfolio.cash+cashDelta).toFixed(2));
    const totalLots = pos.lots+lots;
    pos.avgPrice = ((pos.avgPrice*pos.lots)+(price*lots))/totalLots;
    pos.lots = totalLots; pos.margin += marginDelta;
  } else {
    if(lots > pos.lots){ errBox.textContent='Only '+pos.lots+' lot(s) open. Use Square Off in Positions to close fully.'; errBox.style.display='block'; return; }
    const closeFraction = lots/pos.lots;
    const marginReleased = pos.margin*closeFraction;
    let cashDelta=0;
    if(kind==='FUT'){
      const pnl = pos.side==='long' ? (price-pos.avgPrice)*lots*lotSize : (pos.avgPrice-price)*lots*lotSize;
      cashDelta = marginReleased+pnl;
    } else if(pos.side==='long'){ cashDelta = lots*lotSize*price; }
    else { cashDelta = marginReleased - lots*lotSize*price; }
    portfolio.cash = Number((portfolio.cash+cashDelta).toFixed(2));
    pos.margin -= marginReleased; pos.lots -= lots;
    if(pos.lots<=0) delete portfolio.fno.positions[key];
  }

  portfolio.fno.transactions.push({time:Date.now(), kind, underlying, strike:strike||null, optType:optType||null, side, lots, price:Number(price.toFixed(2)), spotAtEntry:spot});
  await savePortfolio(currentRoll, portfolio);
  closeFnoModal(); refreshTabs();
}
async function squareOffPosition(key){
  const pos = portfolio.fno.positions[key]; if(!pos) return;
  const spot = getSpot(pos.underlying);
  const cfg = pos.kind==='OPT' ? FNO_UNDERLYINGS.find(u=>u.sym===pos.underlying) : null;
  const price = pos.kind==='FUT' ? futPrice(spot) : bsPrice(spot,pos.strike,daysToExpiry()/365,RISK_FREE,cfg.sigma,pos.optType);
  const lots = pos.lots; const marginReleased = pos.margin;
  let cashDelta=0;
  if(pos.kind==='FUT'){
    const pnl = pos.side==='long' ? (price-pos.avgPrice)*lots*pos.lotSize : (pos.avgPrice-price)*lots*pos.lotSize;
    cashDelta = marginReleased+pnl;
  } else if(pos.side==='long'){ cashDelta = lots*pos.lotSize*price; }
  else { cashDelta = marginReleased - lots*pos.lotSize*price; }
  portfolio.cash = Number((portfolio.cash+cashDelta).toFixed(2));
  delete portfolio.fno.positions[key];
  portfolio.fno.transactions.push({time:Date.now(), kind:pos.kind, underlying:pos.underlying, strike:pos.strike||null, optType:pos.optType||null, side: pos.side==='long'?'sell':'buy', lots, price:Number(price.toFixed(2)), spotAtEntry:spot});
  await savePortfolio(currentRoll, portfolio);
  refreshTabs();
}
