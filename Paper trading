/* ===================== SUMMARY STATS ===================== */
function computeHoldingsValue(){
  let value=0, cost=0;
  Object.entries(portfolio.holdings).forEach(([sym,h])=>{
    const stock = STOCKS.find(s=>s.sym===sym);
    if(stock && h.qty>0){ value += stock.ltp*h.qty; cost += h.avgCost*h.qty; }
  });
  return {value, cost, pnl:value-cost};
}
function computeFnoSummary(){
  let marginBlocked=0, unrealizedPnL=0, longOptValue=0;
  Object.values(portfolio.fno.positions).forEach(pos=>{
    const spot = getSpot(pos.underlying);
    if(pos.kind==='FUT'){
      const cur = futPrice(spot);
      const pnl = pos.side==='long' ? (cur-pos.avgPrice)*pos.lots*pos.lotSize : (pos.avgPrice-cur)*pos.lots*pos.lotSize;
      unrealizedPnL += pnl; marginBlocked += pos.margin;
    } else {
      const cfg = FNO_UNDERLYINGS.find(u=>u.sym===pos.underlying);
      const cur = bsPrice(spot, pos.strike, daysToExpiry()/365, RISK_FREE, cfg.sigma, pos.optType);
      if(pos.side==='long'){ longOptValue += cur*pos.lots*pos.lotSize; }
      else { unrealizedPnL += (pos.avgPrice-cur)*pos.lots*pos.lotSize; marginBlocked += pos.margin; }
    }
  });
  return {marginBlocked, unrealizedPnL, longOptValue};
}
function renderSummaryStats(){
  const box = document.getElementById('summaryStats');
  if(!box) return;
  const {value, cost, pnl} = computeHoldingsValue();
  const fno = computeFnoSummary();
  const net = portfolio.cash + value + fno.marginBlocked + fno.unrealizedPnL + fno.longOptValue;
  const pnlPct = cost>0 ? (pnl/cost)*100 : 0;
  box.innerHTML = `
    <div class="stat-card"><div class="lbl">Net Worth</div><div class="val">${inr(net)}</div></div>
    <div class="stat-card"><div class="lbl">Cash</div><div class="val">${inr(portfolio.cash)}</div></div>
    <div class="stat-card"><div class="lbl">Equity Value</div><div class="val">${inr(value)}</div></div>
    <div class="stat-card"><div class="lbl">Equity P&amp;L</div><div class="val ${pnl>=0?'up':'dn'}">${pnl>=0?'+':''}${inr(pnl)} (${pct(pnlPct)})</div></div>
    <div class="stat-card"><div class="lbl">F&amp;O Margin Blocked</div><div class="val">${inr(fno.marginBlocked)}</div></div>
    <div class="stat-card"><div class="lbl">F&amp;O Unrealised P&amp;L</div><div class="val ${fno.unrealizedPnL>=0?'up':'dn'}">${fno.unrealizedPnL>=0?'+':''}${inr(fno.unrealizedPnL)}</div></div>`;
  const cashVal = document.getElementById('cashVal');
  if(cashVal) cashVal.textContent = inr(portfolio.cash);
}

